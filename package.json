{
  "name": "@openoffice/plugin",
  "version": "0.2.0",
  "description": "Office document automation for opencode: draft lifecycle, version history, format conversion, template batch generation.",
  "type": "module",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "turbo run lint typecheck test build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "office",
    "document"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirothedev/opencode-office-plugin.git"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.1.8",
    "@firecrawl/pdf-inspector": "^1.13.0",
    "@opencode-ai/plugin": "0.0.0-next-17444",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "effect": "4.0.0-beta.101",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.77.0",
    "tsc-alias": "^1.9.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
