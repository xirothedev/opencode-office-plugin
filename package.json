{
  "name": "@sunaookamishirokodev/openoffice-plugin-opencode",
  "version": "1.0.0",
  "description": "Office document automation for opencode: draft lifecycle, version history, format conversion, template batch generation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.vi.md"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test --isolate",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts",
    "format": "oxfmt --write src test scripts",
    "format:check": "oxfmt --check src test scripts",
    "check": "turbo run lint format:check typecheck test build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "opencode",
    "plugin",
    "office",
    "document"
  ],
  "author": "xirothedev <lethanhtrung.trungle@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunaookamishirokodev/opencode-office-plugin.git"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@firecrawl/pdf-inspector": "^1.25.2",
    "@opencode/plugin": "2.2.5",
    "@opencode/schema": "2.0.10",
    "diff": "^9.0.0",
    "docx": "^9.15.2",
    "effect": "4.0.0-rc.112",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/xml2js": "^0.4.14",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tsc-alias": "^1.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  }
}
