{
  "name": "@xirothedev/openoffice-plugin-opencode",
  "version": "0.3.0",
  "description": "Office document automation for opencode: draft lifecycle, version history, format conversion, template batch generation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.vi.md"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "turbo run lint typecheck test build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "opencode",
    "plugin",
    "office",
    "document"
  ],
  "author": "xirothedev <lethanhtrung.trungle@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirothedev/opencode-office-plugin.git"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@firecrawl/pdf-inspector": "^1.13.0",
    "@opencode/plugin": "2.0.10",
    "@opencode/schema": "2.0.10",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "effect": "4.0.0-rc.112",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "sharp": "^0.35.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.2.0",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.77.0",
    "tsc-alias": "^1.9.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
